mas vesna {
    agent austria-hungary:austria-hungary.asl {
        beliefs:    address( localhost )
                    port( 9080 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }

    agent italy:italy.asl {
        beliefs:    address( localhost )
                    port( 9081 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }

    agent the_german_empire:the_german_empire.asl {
        beliefs:    address( localhost )
                    port( 9082 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
    agent france:france.asl {
        beliefs:    address( localhost )
                    port( 9083 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
    agent spain:spain.asl {
        beliefs:    address( localhost )
                    port( 9084 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
    agent united_kingdom:united_kingdom.asl {
        beliefs:    address( localhost )
                    port( 9085 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
}
