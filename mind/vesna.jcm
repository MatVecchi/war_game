mas vesna {
    agent russia:russia.asl {
        beliefs:    address( localhost )
                    port( 9080 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }

    agent ukraine:ukraine.asl {
        beliefs:    address( localhost )
                    port( 9081 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }

    agent lithuania:lithuania.asl {
        beliefs:    address( localhost )
                    port( 9082 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
    agent finland:finland.asl {
        beliefs:    address( localhost )
                    port( 9083 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
    agent sweden:sweden.asl {
        beliefs:    address( localhost )
                    port( 9084 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
    agent norway:norway.asl {
        beliefs:    address( localhost )
                    port( 9085 )
        goals:      start
        ag-class:   vesna.CountryAgent
    }
}
